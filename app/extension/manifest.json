{
  "manifest_version": 3,
  "name": "HangUp — check before you call",
  "version": "0.2.0",
  "description": "Reads the PayPal invoice page (or the PayPal invoice email open in Gmail) and warns you if its note is a callback scam. Independent tool, not affiliated with PayPal.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://payyourpal-hangup.onrender.com/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.paypal.com/invoice/p/*",
        "https://www.sandbox.paypal.com/invoice/p/*",
        "https://www.paypal.com/invoice/payerView/*",
        "https://www.sandbox.paypal.com/invoice/payerView/*"
      ],
      "js": [
        "banner.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://mail.google.com/mail/*",
        "https://payyourpal-hangup.onrender.com/demo-email.html",
        "http://localhost:3000/demo-email.html"
      ],
      "js": [
        "banner.js",
        "gmail.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "HangUp",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
