# Copy to .env in the repository root (next to this file) and fill in your own values. Never commit .env.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# optional: PayPal webhook id (enables verified INVOICING.* webhooks)
PAYPAL_WEBHOOK_ID=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# optional: HANGUP_MODEL=anthropic/claude-haiku-5.5
